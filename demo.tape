# AI-Rulez Quick Start Demo
Output docs/assets/ai-rulez-demo.gif

# Terminal setup
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 700
Set Theme "Dracula"
Set Padding 30
Set BorderRadius 10
Set WindowBar Colorful
Set TypingSpeed 75ms

# Start demo
Type "# AI-Rulez: Lightning-fast AI assistant configuration"
Enter
Sleep 1.5s

Type "# Initialize a new project with popular AI presets"
Enter
Sleep 500ms

Type "npx ai-rulez init 'My Awesome Project' --preset popular"
Enter
Sleep 3s

Type "# Validate the configuration"
Enter
Sleep 500ms

Type "npx ai-rulez validate"
Enter
Sleep 2s

Type "# Add a custom rule"
Enter
Sleep 500ms

Type "npx ai-rulez add rule --name 'testing' --content 'Write comprehensive tests' --priority high"
Enter
Sleep 2s

Type "# Generate output files for your AI assistants"
Enter
Sleep 500ms

Type "npx ai-rulez generate"
Enter
Sleep 2.5s

Type "# Check what was created"
Enter
Sleep 500ms

Type "ls -la *.md .claude/"
Enter
Sleep 2s

Type "# View the generated configuration"
Enter
Sleep 500ms

Type "head -25 CLAUDE.md"
Enter
Sleep 3s

Type "echo '🚀 Ready to enhance your AI workflow!'"
Enter
Sleep 2s