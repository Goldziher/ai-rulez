{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$QWEN_PROJECT_DIR\"/'scripts/guard.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo started",
            "statusMessage": "Starting"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "local-tool": {
      "args": [
        "-y",
        "golden-mcp"
      ],
      "command": "npx",
      "env": {
        "API_TOKEN": "golden-secret-value"
      }
    },
    "remote-tool": {
      "headers": {
        "Authorization": "Bearer golden-secret-value"
      },
      "httpUrl": "https://mcp.example.com/mcp"
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Read(./src/**)",
      "WebFetch(domain:example.com)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  }
}
