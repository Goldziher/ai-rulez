{
  "context": {
    "fileName": [
      "GEMINI.md",
      "GEMINI.local.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$GEMINI_PROJECT_DIR\"/'scripts/guard.sh'",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "^replace$|^write_file$",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ai-rulez@$VERSION guard",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo started"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ai-rulez": {
      "args": [
        "-y",
        "ai-rulez@latest",
        "mcp"
      ],
      "command": "npx"
    },
    "local-tool": {
      "args": [
        "-y",
        "golden-mcp"
      ],
      "command": "npx",
      "env": {
        "API_TOKEN": "${GOLDEN_TOKEN}"
      }
    },
    "remote-tool": {
      "headers": {
        "Authorization": "Bearer ${GOLDEN_TOKEN}"
      },
      "httpUrl": "https://mcp.example.com/mcp"
    }
  },
  "tools": {
    "allowed": [
      "run_shell_command(npm run test )"
    ],
    "exclude": [
      "run_shell_command(rm -rf)"
    ]
  }
}
