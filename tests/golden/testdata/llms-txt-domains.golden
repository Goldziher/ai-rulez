.ai-rulez/config.toml file 0644 791 7c27b4dd811bb200120286f9976a2fcfc1b63679ddf03a9fbaa40a658abd5052
>>>>
version = "5.0"
name = "golden"
description = "Golden fixture project"
presets = ["claude", "llms-txt"]
gitignore = true
agents_md = false

[guard]
generated = true

[permissions]
allow = ["Bash(npm run test:*)", "Read(./src/**)", "WebFetch(domain:example.com)"]
ask = ["Bash(git push:*)"]
deny = ["Bash(rm -rf:*)", "Read(./.env)"]

[[hooks]]
event = "PreToolUse"
matcher = "Bash"
[[hooks.hooks]]
script = "scripts/guard.sh"
timeout = 10

[[hooks]]
event = "SessionStart"
[[hooks.hooks]]
command = "echo started"
status_message = "Starting"

[profiles]
backend = ["backend"]
frontend = ["frontend"]
full = ["backend", "frontend"]

[llms_txt]
dir = "docs"
include = ["rules", "context", "skills", "agents", "commands"]
title = "Golden docs"
summary = "Everything an agent should read first."
