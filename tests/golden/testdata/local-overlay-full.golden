      "headers": {
        "Authorization": "Bearer {env:GOLDEN_TOKEN}"
      },
      "type": "remote",
      "url": "https://mcp.example.com/mcp"
    }
  },
  "permission": {
    "bash": {
      "git push *": "ask",
      "npm run test *": "allow",
      "rm -rf *": "deny"
    },
    "read": {
      "**/.env": "deny",
      ".env": "deny"
    },
    "webfetch": {
      "https://example.com/*": "allow"
    }
  }
}
