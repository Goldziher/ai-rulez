    "PreToolUse"
  ],
  "tools": {
    "apply_patch": [
      "Edit",
      "MultiEdit",
      "Write"
    ],
    "bash": [
      "Bash"
    ],
    "edit": [
      "Edit",
      "MultiEdit"
    ],
    "glob": [
      "Glob"
    ],
    "grep": [
      "Grep"
    ],
    "read": [
      "Read"
    ],
    "skill": [
      "Skill"
    ],
    "task": [
      "Task",
      "Agent"
    ],
    "todowrite": [
      "TodoWrite"
    ],
    "webfetch": [
      "WebFetch"
    ],
    "websearch": [
      "WebSearch"
    ],
    "write": [
      "Write"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "command": "'./scripts/guard.sh'",
        "timeout": 10000
      }
    ],
    "SessionStart": [
      {
        "command": "echo started"
      }
    ]
  }
};

const DEFAULT_TIMEOUT_MS = 600000;
const MAX_OUTPUT_LENGTH = 1048576;
const MAX_REASON_LENGTH = 2000;
const matchers = new Map();

function log(message) {
  console.error(`[ai-rulez hooks] ${message}`);
}

