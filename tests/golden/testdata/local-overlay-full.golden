      if (stderr.length < MAX_OUTPUT_LENGTH) stderr += chunk;
    });
    child.on("error", (error) => {
      stderr = stderr || String(error.message);
      finish(null);
    });
    child.on("close", (code) => finish(code));
    child.stdin.on("error", () => {});
    child.stdin.end(stdin);
  });
}

// Exit code 2, or a JSON decision of block or deny on stdout, blocks a blocking event.
function blockReason(event, result) {
  if (!HOOK_CONFIG.blocking.includes(event) || result.timedOut) return null;
  if (result.code === 2) return clean(result.stderr.trim() || result.stdout.trim());
  const text = result.stdout.trim();
  if (result.code !== 0 || !text.startsWith("{")) return null;
  try {
    const decision = JSON.parse(text);
    const specific = decision.hookSpecificOutput ?? {};
    if (decision.decision === "block" || decision.decision === "deny") return clean(decision.reason ?? "");
    if (specific.permissionDecision === "deny") return clean(specific.permissionDecisionReason ?? "");
  } catch {
    // Plain output is not a decision.
  }
  return null;
}

function report(event, index, result) {
  if (result.timedOut) {
    log(`${event} hook ${index} timed out`);
  } else if (result.code !== 0) {
    const detail = result.stderr.trim().split("\n")[0];
    log(`${event} hook ${index} failed (${result.code === null ? "not run" : `exit ${result.code}`})${detail ? `: ${detail}` : ""}`);
  }
}

// Runs the hooks of an event in order and returns the reason of the first one that blocks, or null.
// target is { tool } for a tool event, { subject } for an event matched on a string, or absent.
async function dispatch(event, dir, fields, target) {
  const hooks = HOOK_CONFIG.hooks[event] ?? [];
  const subjects = target === undefined ? null : target.tool !== undefined ? toolNames(target.tool) : [target.subject];
  const input = { session_id: "", cwd: dir, hook_event_name: event };
  if (target !== undefined && target.tool !== undefined) {
    input.tool_name = toolNames(target.tool)[1] ?? target.tool;
    input.harness_tool_name = target.tool;
  }
  Object.assign(input, fields);
  if (input.session_id === undefined) input.session_id = "";
  if (target !== undefined && target.tool !== undefined) input.tool_input = normalizeInput(fields.tool_input);
  let stdin;
  try {
    stdin = JSON.stringify(input);
  } catch (error) {
    log(`cannot encode the input of the ${event} hooks: ${error.message}`);
    return null;
  }
  for (let index = 0; index < hooks.length; index += 1) {
    const hook = hooks[index];
    if (subjects !== null && !matches(hook.matcher, subjects)) continue;
    if (hook.async) {
      void runCommand(hook, stdin, dir, event).then((result) => report(event, index, result));
      continue;
    }
    const result = await runCommand(hook, stdin, dir, event);
    const reason = blockReason(event, result);
    if (reason !== null) return reason;
    report(event, index, result);
  }
  return null;
}

// Session events: the v1 plugin API delivers them to the event hook, v2 through ctx.event.subscribe.
async function handleEvent(event, dir) {
  const sessionId = event?.properties?.sessionID ?? event?.properties?.info?.id ?? event?.sessionID ?? "";
  try {
    await handleSessionEvent(event, dir, sessionId);
  } catch (error) {
    log(`the ${event?.type} hooks failed: ${error?.message ?? error}`);
  }
}

async function handleSessionEvent(event, dir, sessionId) {
  switch (event?.type) {
    case "session.created":
      await dispatch("SessionStart", dir, { session_id: sessionId, source: "startup" }, { subject: "startup" });
      break;
    default:
      break;
  }
}

// OpenCode v1 (and its forks): the hooks object the server function returns.
async function server(ctx) {
  const dir = ctx?.directory ?? process.cwd();
  return {
    event: async ({ event }) => {
      await handleEvent(event, dir);
    },
    "tool.execute.before": async (input, output) => {
      const reason = await dispatch(
        "PreToolUse",
        dir,
        { session_id: input.sessionID, tool_use_id: input.callID, tool_input: output?.args },
        { tool: input.tool },
      );
      if (reason !== null) throw new Error(reason);
    },
  };
}

// OpenCode v2: registers the same hooks on the plugin context. v2 ignores server and v1 ignores setup.
async function setup(ctx) {
  const dir = ctx?.location?.directory ?? process.cwd();
  await ctx.tool.hook("execute.before", async (event) => {
    const reason = await dispatch(
      "PreToolUse",
      dir,
      { session_id: event.sessionID, tool_input: event.input },
      { tool: event.tool },
    );
    if (reason !== null) throw new Error(reason);
  });
  const controller = new AbortController();
  void (async () => {
    try {
      for await (const event of ctx.event.subscribe({ signal: controller.signal })) {
        await handleEvent(event, dir);
      }
    } catch (error) {
      if (!controller.signal.aborted) log(`the event stream ended: ${error?.message ?? error}`);
    }
  })();
}

export default {
  id: "ai-rulez-hooks",
  setup,
  server,
};
