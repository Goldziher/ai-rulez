kilo.jsonc file 0600 915 c18268664298f582eed44cd5947f66d6f4961874cc2f6994059f3f52bd0ae259
>>>>
{
  "instructions": [
    ".kilo/rules/*.md"
  ],
  "mcp": {
    "local-tool": {
      "command": [
        "npx",
        "-y",
        "golden-mcp"
      ],
      "enabled": true,
      "environment": {
        "API_TOKEN": "{env:GOLDEN_TOKEN}"
      },
      "type": "local"
    },
    "personal": {
      "command": [
        "personal-mcp",
        "--token",
        "${GOLDEN_TOKEN}"
      ],
      "enabled": true,
      "type": "local"
    },
    "remote-tool": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GOLDEN_TOKEN}"
      },
      "type": "remote",
      "url": "https://mcp.example.com/mcp"
    }
  },
  "permission": {
    "bash": {
      "git push *": "ask",
      "npm run test *": "allow",
      "rm -rf *": "deny"
    },
    "read": {
      "**/.env": "deny",
      ".env": "deny"
    },
    "webfetch": {
      "https://example.com/*": "allow"
    }
  }
}
