{
  "instructions": [
    ".kilo/rules/*.md"
  ],
  "mcp": {
    "local-tool": {
      "command": [
        "npx",
        "-y",
        "golden-mcp"
      ],
      "enabled": true,
      "environment": {
        "API_TOKEN": "{env:GOLDEN_TOKEN}"
      },
      "type": "local"
    },
    "personal": {
      "command": [
        "personal-mcp",
        "--token",
