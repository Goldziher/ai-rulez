.ai-rulez/config.toml file 0644 703 3854433429318a2e5a18bca2ffea9ba1cf621430c2651bfb423c6c64a10786e7
>>>>
version = "4.0"
name = "golden"
description = "Golden fixture project"
presets = ["claude", "opencode"]
gitignore = true

[guard]
generated = true

[[mcp_servers]]
name = "public-tool"
command = "npx"
args = ["-y", "public-mcp"]

[[mcp_servers]]
name = "public-remote"
transport = "http"
url = "https://mcp.example.com/public"

[permissions]
allow = ["Bash(npm run test:*)", "Read(./src/**)", "WebFetch(domain:example.com)"]
ask = ["Bash(git push:*)"]
deny = ["Bash(rm -rf:*)", "Read(./.env)"]

[[hooks]]
event = "PreToolUse"
matcher = "Bash"
[[hooks.hooks]]
script = "scripts/guard.sh"
timeout = 10

[[hooks]]
event = "SessionStart"
[[hooks.hooks]]
command = "echo started"
status_message = "Starting"
