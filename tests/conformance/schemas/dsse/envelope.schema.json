{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rulez.dev/conformance/dsse-envelope.schema.json",
  "title": "DSSE v1 envelope (shape transcribed from envelope.md and protocol.md; not an upstream file)",
  "type": "object",
  "required": ["payload", "payloadType", "signatures"],
  "properties": {
    "payload": { "type": "string", "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/_-]*={0,2}$" },
    "payloadType": { "type": "string", "minLength": 1 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sig"],
        "properties": {
          "sig": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/_-]+={0,2}$" },
          "keyid": { "type": "string" }
        }
      }
    }
  }
}
