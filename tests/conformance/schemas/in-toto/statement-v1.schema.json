{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rulez.dev/conformance/in-toto-statement-v1.schema.json",
  "title": "in-toto Statement v1 (shape transcribed from spec/v1/statement.md; not an upstream file)",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "name": { "type": "string" },
          "uri": { "type": "string" },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z0-9_]+$" },
            "additionalProperties": { "type": "string", "pattern": "^[a-fA-F0-9]+$" }
          },
          "annotations": { "type": "object" }
        }
      }
    },
    "predicateType": { "type": "string", "format": "uri", "minLength": 1 },
    "predicate": { "type": "object" }
  }
}
