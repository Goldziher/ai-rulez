{
  "name": "Shell Completion",
  "description": "Test shell autocompletion functionality",
  "tests": [
    {
      "name": "completion_help",
      "description": "Show completion command help",
      "command": ["completion", "--help"],
      "expected_out": "Generate the autocompletion script for ai-rulez",
      "exit_code": 0
    },
    {
      "name": "bash_completion",
      "description": "Generate bash completion script",
      "command": ["completion", "bash"],
      "expected_out": "# bash completion V2 for ai-rulez",
      "exit_code": 0
    },
    {
      "name": "zsh_completion",
      "description": "Generate zsh completion script",
      "command": ["completion", "zsh"],
      "expected_out": "#compdef ai-rulez",
      "exit_code": 0
    },
    {
      "name": "fish_completion",
      "description": "Generate fish completion script",
      "command": ["completion", "fish"],
      "expected_out": "complete -c ai-rulez",
      "exit_code": 0
    },
    {
      "name": "powershell_completion",
      "description": "Generate PowerShell completion script",
      "command": ["completion", "powershell"],
      "expected_out": "# powershell completion for ai-rulez",
      "exit_code": 0
    },
    {
      "name": "invalid_shell_completion",
      "description": "Try to generate completion for invalid shell shows help",
      "command": ["completion", "invalidshell"],
      "expected_out": "Available Commands:",
      "exit_code": 0
    }
  ]
}