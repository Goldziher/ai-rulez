{
  "name": "Version and Global Options",
  "description": "Test version command and global configuration options",
  "tests": [
    {
      "name": "version_flag",
      "description": "Show version with --version flag",
      "command": ["--version"],
      "expected_out": "ai-rulez version",
      "exit_code": 0
    },
    {
      "name": "version_short_flag", 
      "description": "Show version with -v flag",
      "command": ["-v"],
      "expected_out": "ai-rulez version",
      "exit_code": 0
    },
    {
      "name": "version_command",
      "description": "Show version with version command",
      "command": ["version"],
      "expected_out": "ai-rulez version",
      "exit_code": 0
    },
    {
      "name": "global_config_flag_documented",
      "description": "Global config flag is documented in help",
      "command": ["--help"],
      "expected_out": "--config string",
      "exit_code": 0
    },
    {
      "name": "validate_help_shows_global_flag",
      "description": "Validate command shows global config flag",
      "command": ["validate", "--help"],
      "expected_out": "--config string",
      "exit_code": 0
    }
  ]
}