{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/eval-activation.v1.schema.json",
  "title": "ai-rulez eval run --mode activation result",
  "description": "Output of `ai-rulez eval run --mode activation --format json`, on the retrieval surface (offline ranking) or the native one (a harness's model, repeated runs): per-prompt activation of each skill, rates with Wilson 95% intervals, rank metrics (retrieval) and the confusion between sibling skills.",
  "type": "object",
  "required": ["schema_version", "mode", "surface", "scope", "note", "cost", "skills", "confusion", "failed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "const": "activation" },
    "surface": { "enum": ["retrieval", "native"] },
    "scope": {
      "enum": ["domain", "all"],
      "description": "Which skills compete for a prompt: the skill's domain plus the root skills, or every skill."
    },
    "note": { "type": "string", "description": "What the surface measures and what it does not." },
    "date": { "type": "string" },
    "runner": { "type": "string", "description": "Native surface: the runner that ran the prompts." },
    "harness": { "type": "string" },
    "model": { "type": "string" },
    "runs": { "type": "integer", "minimum": 1, "description": "Native surface: how often each prompt was repeated." },
    "dry_run": { "type": "boolean", "description": "The run only estimated; no runner was called." },
    "estimate": { "$ref": "#/definitions/estimate" },
    "cost": {
      "type": "object",
      "required": ["estimate_usd", "actual_usd"],
      "additionalProperties": false,
      "properties": {
        "estimate_usd": { "type": "number", "minimum": 0 },
        "actual_usd": { "type": "number", "minimum": 0 }
      }
    },
    "skills": { "type": "array", "items": { "$ref": "#/definitions/skill" } },
    "confusion": {
      "type": "object",
      "description": "confusion[expected][won]: retrieval counts the positive prompts of skill `expected` that skill `won` ranked first on, native counts the runs on which `won` loaded; `none` when nothing ranked or loaded.",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
    },
    "failed": { "type": "boolean" }
  },
  "definitions": {
    "estimate": {
      "type": "object",
      "description": "Projected size and cost: the unsuffixed fields are the expected figure, the low and high fields bound it.",
      "required": ["agent_runs", "input_tokens", "output_tokens", "cost_usd", "cost_low_usd", "cost_high_usd"],
      "properties": {
        "agent_runs": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "input_tokens_low": { "type": "integer", "minimum": 0 },
        "input_tokens_high": { "type": "integer", "minimum": 0 },
        "output_tokens_low": { "type": "integer", "minimum": 0 },
        "output_tokens_high": { "type": "integer", "minimum": 0 },
        "cost_low_usd": { "type": "number", "minimum": 0 },
        "cost_high_usd": { "type": "number", "minimum": 0 }
      }
    },
    "estimate_record": {
      "type": "object",
      "description": "The projection of a run next to what the runner reported.",
      "required": ["low_usd", "expected_usd", "high_usd", "expected_tokens"],
      "properties": {
        "low_usd": { "type": "number" },
        "expected_usd": { "type": "number" },
        "high_usd": { "type": "number" },
        "expected_tokens": { "type": "integer" },
        "agent_runs": { "type": "integer" },
        "expected_input_tokens": { "type": "integer" },
        "expected_output_tokens": { "type": "integer" },
        "actual_usd": { "type": "number" },
        "actual_tokens": { "type": "integer" },
        "actual_input_tokens": { "type": "integer" },
        "actual_output_tokens": { "type": "integer" },
        "error": { "type": "number", "description": "actual/expected - 1 over USD." },
        "in_range": { "type": "boolean" }
      }
    },
    "interval": {
      "type": "object",
      "required": ["low", "high"],
      "additionalProperties": false,
      "properties": {
        "low": { "type": "number", "minimum": 0, "maximum": 1 },
        "high": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rate": {
      "type": ["object", "null"],
      "description": "A proportion with its Wilson 95% interval; null when the denominator is zero.",
      "required": ["value", "n", "interval"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "n": {
          "type": "integer",
          "minimum": 0,
          "description": "Trials behind the rate; 0 on a replayed stored figure, which keeps only the value."
        },
        "interval": { "$ref": "#/definitions/interval" }
      }
    },
    "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "problem": {
      "type": "object",
      "required": ["file", "line", "message"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "message": { "type": "string" }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["case", "expect", "rate", "runs", "rank", "winner", "top_score", "status"],
      "additionalProperties": false,
      "properties": {
        "case": { "type": "string" },
        "expect": { "type": "boolean", "description": "Whether the skill should fire for the prompt." },
        "near_miss": { "type": "boolean" },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of runs in which the skill fired."
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "description": "Runs behind the rate; 0 for a prompt the runner gave no result for."
        },
        "interval": { "$ref": "#/definitions/interval" },
        "fired_counts": {
          "type": "object",
          "description": "Native surface: how often each skill loaded over the runs; `none` counts runs in which no skill loaded.",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "error": { "type": "string", "description": "Native surface: why the prompt has no result." },
        "rank": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "1-based rank of the skill among the competing skills; null when it did not rank."
        },
        "winner": {
          "type": "string",
          "description": "The skill that ranked first (retrieval) or loaded most often (native), or `none`."
        },
        "top_score": { "type": "number", "minimum": 0 },
        "status": {
          "enum": ["passed", "failed", "borderline", "error"],
          "description": "borderline: passes, but one run the other way would fail it (native, 3 or more runs, never a perfect score)."
        }
      }
    },
    "skill": {
      "type": "object",
      "required": [
        "id",
        "status",
        "passing",
        "precision",
        "recall",
        "false_activation",
        "recall_at_1",
        "recall_at_3",
        "mrr"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "status": {
          "enum": [
            "ran",
            "cached",
            "dry-run",
            "no-cases",
            "invalid",
            "error",
            "skipped-unchanged",
            "skipped-over-budget"
          ]
        },
        "competing": { "type": "array", "items": { "type": "string" } },
        "digest": { "type": "string" },
        "set_digest": {
          "type": "string",
          "description": "Digest of the competing set: a sibling's changed description changes it."
        },
        "passing": { "type": "boolean" },
        "precision": { "$ref": "#/definitions/rate" },
        "recall": { "$ref": "#/definitions/rate" },
        "false_activation": { "$ref": "#/definitions/rate" },
        "run_recall": {
          "$ref": "#/definitions/rate",
          "description": "Native: fires over runs across the positive prompts."
        },
        "run_false_activation": {
          "$ref": "#/definitions/rate",
          "description": "Native: fires over runs across the negative prompts."
        },
        "cost_usd": { "type": "number", "minimum": 0 },
        "estimate_vs_actual": { "$ref": "#/definitions/estimate_record" },
        "recall_at_1": { "$ref": "#/definitions/fraction" },
        "recall_at_3": { "$ref": "#/definitions/fraction" },
        "mrr": { "$ref": "#/definitions/fraction" },
        "ignored": {
          "type": "integer",
          "minimum": 0,
          "description": "Cases whose fixtures, assertions or rubric were not used."
        },
        "prompts": { "type": "array", "items": { "$ref": "#/definitions/prompt" } },
        "stolen_by": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "prompts", "share"],
            "additionalProperties": false,
            "properties": {
              "skill": { "type": "string" },
              "prompts": { "type": "integer", "minimum": 1 },
              "share": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "problems": { "type": "array", "items": { "$ref": "#/definitions/problem" } },
        "error": { "type": "string" }
      }
    }
  }
}
