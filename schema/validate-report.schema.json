{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/validate-report.schema.json",
  "title": "ai-rulez validate report",
  "description": "Output of `ai-rulez validate --format json` and `ai-rulez scan --format json`: the content-check findings of every root.",
  "type": "object",
  "required": ["schema_version", "roots", "findings", "summary"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "enum": ["error", "warning", "info", "off"]
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "source": {
            "description": "Where the finding's file comes from when it is not authored content: \"output\" for a generated file linted with --outputs or [lint] lint_outputs. Absent for authored content.",
            "enum": ["output"]
          },
          "full_message": {
            "type": "string",
            "description": "The whole message of an external scanner finding (AR011) whose message was cut to the scanner's max_message. Absent when message is whole."
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "errors", "warnings", "infos"],
      "properties": {
        "total": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        },
        "infos": {
          "type": "integer"
        },
        "by_code": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "notices": {
      "description": "Picked files that were not linted (--path, --glob, [lint] paths), each as \"<file>: not linted (<reason>)\". Absent when every picked file was linted.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline": {
      "type": "object"
    },
    "ratchet_exceeded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "count", "max"],
        "properties": {
          "code": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          }
        }
      }
    },
    "profile": {
      "type": "string"
    },
    "risk": {
      "type": "object"
    },
    "changed_only": {
      "type": "object"
    }
  }
}
