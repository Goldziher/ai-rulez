{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/eval-report.schema.json",
  "title": "ai-rulez eval report",
  "description": "Output of `ai-rulez eval run --format json`: per-skill eval results, the cost estimate and the pass/fail verdict.",
  "type": "object",
  "required": [
    "schema_version",
    "runner",
    "harness",
    "model",
    "ablation",
    "dry_run",
    "skills",
    "estimate",
    "cost_usd",
    "failed"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runner": {
      "type": "string"
    },
    "harness": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "ablation": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "estimate": {
      "type": "object"
    },
    "cost_usd": {
      "type": "number"
    },
    "failed": {
      "type": "boolean"
    }
  }
}
