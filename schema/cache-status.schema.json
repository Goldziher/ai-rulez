{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/cache-status.schema.json",
  "title": "ai-rulez cache status",
  "description": "Output of `ai-rulez cache status --format json`: where the repository index cache of this project is, what it holds and what is wrong with it.",
  "type": "object",
  "required": ["schema_version", "mode", "kind", "exists", "bytes", "entries", "verdicts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["user", "repo", "off"], "description": "The configured [mcp] index_cache mode." },
    "kind": { "enum": ["user", "repo", "off"], "description": "Where the cache is." },
    "dir": {
      "type": "string",
      "description": "The cache directory, or where it would be; absent when the cache is off."
    },
    "exists": { "type": "boolean" },
    "fallback": {
      "type": "boolean",
      "description": "The project directory holds the cache of a project that asked for the user cache."
    },
    "bytes": { "type": "integer", "minimum": 0 },
    "entries": { "type": "integer", "minimum": 0 },
    "verdicts": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
