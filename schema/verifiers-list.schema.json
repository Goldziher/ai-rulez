{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/verifiers-list.schema.json",
  "title": "ai-rulez verifiers list",
  "description": "Output of `ai-rulez verifiers list --format json`: the declared verifiers.",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "severity",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "description": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "invalid": {
            "type": "string"
          }
        }
      }
    }
  }
}
