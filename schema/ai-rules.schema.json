{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Goldziher/ai-rulez/schema/ai-rules-v3.schema.json",
  "title": "AI Rules Configuration V3",
  "description": "Schema for ai-rulez V3 directory-based configuration files",
  "type": "object",
  "required": ["version", "name"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema for editor support"
    },
    "version": {
      "type": "string",
      "enum": ["3.0", "4.0"],
      "description": "Configuration version (3.0 or 4.0)"
    },
    "name": {
      "type": "string",
      "description": "Project name",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "presets": {
      "type": "array",
      "description": "List of presets to generate (built-in tool names or custom preset objects)",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["claude", "cursor", "gemini", "copilot", "continue-dev", "windsurf", "cline", "codex", "amp", "junie", "opencode"],
            "description": "Built-in preset name"
          },
          {
            "type": "object",
            "required": ["name", "type", "path"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Custom preset name",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": ["markdown", "directory", "json"],
                "description": "Output type"
              },
              "path": {
                "type": "string",
                "description": "Output path",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "description": "Template content for custom presets"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "default": {
      "type": "string",
      "description": "Default profile name to use when --profile is not specified"
    },
    "profiles": {
      "type": "object",
      "description": "Named profiles mapping profile names to lists of domain names",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gitignore": {
      "type": "boolean",
      "description": "Whether to automatically update .gitignore with generated files (defaults to true)",
      "default": true
    },
    "builtins": {
      "description": "Built-in domains to include. Use `true` to enable all, `false` to disable all, or an array of specific names. Prefix with '!' to exclude auto-includes (e.g., '!ai-governance'). Available: ai-governance (auto), agent-delegation (auto), security, git-workflow, code-quality, testing, token-efficiency, documentation, default-commands, rust, python, typescript, go, java, ruby, php, elixir, csharp, pyo3, napi-rs, magnus, ext-php-rs, rustler, wasm",
      "oneOf": [
        {
          "type": "boolean",
          "description": "true = enable all builtins, false = disable all (including auto-includes)"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^!?(ai-governance|agent-delegation|security|git-workflow|code-quality|testing|token-efficiency|documentation|default-commands|rust|python|typescript|go|java|ruby|php|elixir|csharp|r|pyo3|napi-rs|magnus|ext-php-rs|rustler|wasm|jni-rs|extendr|cgo)$"
          }
        }
      ]
    },
    "installed_skills": {
      "type": "array",
      "description": "Named skills to install from external repositories. Skills are fetched dynamically during generation.",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name (unique identifier)",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Git repository URL (https://...) or local file path",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Path within repository to skill directory (defaults to skills/<name>)"
          },
          "ref": {
            "type": "string",
            "description": "Git ref - branch, tag, or commit hash (git repos only)"
          },
          "local_override": {
            "type": "string",
            "description": "Local path override for development (used instead of source when present)"
          }
        },
        "additionalProperties": false
      }
    },
    "includes": {
      "type": "array",
      "description": "Content sources (git repositories or local paths) to include and merge",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Local identifier for this include"
          },
          "source": {
            "type": "string",
            "description": "Git repository URL (https://...) or local file path (absolute or relative)"
          },
          "path": {
            "type": "string",
            "description": "Path within git repository to .ai-rulez/ or domain folder (git repos only)"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["rules", "context", "skills", "agents", "mcp"]
            },
            "description": "What content types to import (defaults to all)"
          },
          "ref": {
            "type": "string",
            "description": "Git ref - branch, tag, or commit hash (git repos only)"
          },
          "install_to": {
            "type": "string",
            "description": "Where to merge content (defaults to root)"
          },
          "merge_strategy": {
            "type": "string",
            "enum": ["local-override", "domain-override", "error"],
            "description": "How to handle conflicting files"
          }
        },
        "additionalProperties": false
      }
    },
    "header": {
      "type": "object",
      "description": "Header style configuration for generated files",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["detailed", "compact", "minimal"],
          "description": "Header style: detailed (comprehensive), compact (concise), or minimal (bare minimum)",
          "default": "detailed"
        }
      },
      "additionalProperties": false
    },
    "compression": {
      "type": "object",
      "description": "DEPRECATED: Compression is now a no-op and will be removed in a future version. Condense content at the source level instead.",
      "deprecated": true,
      "properties": {
        "level": {
          "type": "string"
        },
        "preserve_markdown": {
          "type": "boolean"
        },
        "preserve_code": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": "https://github.com/Goldziher/ai-rulez/schema/ai-rules-v3.schema.json",
      "version": "3.0",
      "name": "my-project",
      "description": "Example V3 configuration",
      "presets": [
        "claude",
        "cursor",
        {
          "name": "custom-guide",
          "type": "markdown",
          "path": "docs/AI_GUIDE.md"
        }
      ],
      "builtins": ["rust", "python", "pyo3", "security", "git-workflow", "code-quality", "testing"],
      "default": "full",
      "profiles": {
        "full": ["backend", "frontend", "qa"],
        "backend": ["backend", "qa"],
        "frontend": ["frontend", "qa"]
      },
      "gitignore": true,
      "header": {
        "style": "detailed"
      }
    }
  ]
}
