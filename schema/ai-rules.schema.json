{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Goldziher/ai-rulez/schema/ai-rules-v3.schema.json",
  "title": "AI Rules Configuration V3",
  "description": "Schema for ai-rulez V3 directory-based configuration files",
  "type": "object",
  "required": ["version", "name"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema for editor support"
    },
    "version": {
      "type": "string",
      "enum": ["3.0", "4.0"],
      "description": "Configuration version (3.0 or 4.0)"
    },
    "name": {
      "type": "string",
      "description": "Project name",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Project description"
    },
    "presets": {
      "type": "array",
      "description": "List of presets to generate (built-in tool names or custom preset objects)",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "claude",
              "cursor",
              "gemini",
              "copilot",
              "continue-dev",
              "windsurf",
              "cline",
              "codex",
              "amp",
              "junie",
              "opencode",
              "hermes",
              "antigravity"
            ],
            "description": "Built-in preset name"
          },
          {
            "type": "object",
            "required": ["name", "type", "path"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Custom preset name",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": ["markdown", "directory", "json"],
                "description": "Output type"
              },
              "path": {
                "type": "string",
                "description": "Output path",
                "minLength": 1
              },
              "template": {
                "type": "string",
                "description": "Template content for custom presets"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "default": {
      "type": "string",
      "description": "Default profile name to use when --profile is not specified"
    },
    "profiles": {
      "type": "object",
      "description": "Named profiles mapping profile names to lists of domain names",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scopes": {
      "type": "array",
      "description": "Additional scoped output roots, such as subfolder AGENTS.md and CLAUDE.md files with profile-specific content.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional display name for the scope"
          },
          "path": {
            "type": "string",
            "description": "Subdirectory where scoped assistant files should be generated",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "description": "Profile used for this scope. Defaults to the active generation profile."
          },
          "presets": {
            "type": "array",
            "description": "Assistant presets to generate in this scope. Defaults to codex and claude.",
            "items": {
              "type": "string",
              "enum": ["claude", "codex"]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gitignore": {
      "type": "boolean",
      "description": "Whether to automatically update .gitignore with generated output patterns (defaults to true)",
      "default": true
    },
    "mcp_servers": {
      "type": "array",
      "description": "Inline Model Context Protocol (MCP) server definitions generated into assistant MCP configuration files.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "MCP server name/identifier (used as unique key)",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Optional description of the MCP server capabilities"
          },
          "command": {
            "type": "string",
            "description": "Command to start a local stdio MCP server (e.g., 'npx', 'uvx', 'node')",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "description": "Command line arguments for a local MCP server",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "description": "Environment variables for the MCP server. Values may contain ${VAR} placeholders; placeholder names must match [A-Za-z_][A-Za-z0-9_]* and are resolved by ai-rulez generate from repeated --env KEY=VALUE, process env, then dotenv files.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "transport": {
            "type": "string",
            "enum": ["stdio", "http", "sse"],
            "description": "Transport protocol for MCP server communication (default: stdio)",
            "default": "stdio"
          },
          "url": {
            "type": "string",
            "description": "URL for remote MCP servers using http or sse transport",
            "pattern": "^https?://[^\\s]+$"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this MCP server is emitted into generated MCP outputs (default: true)",
            "default": true
          }
        },
        "additionalProperties": false
      }
    },
    "builtins": {
      "description": "Built-in domains to include. Use `true` to enable all, `false` to disable all, or an array of specific names. Prefix with '!' to exclude an entire auto-included domain (e.g., '!ai-governance'), or use '!domain/rule' to exclude a single builtin rule while keeping the rest of the domain (e.g., '!git-workflow/commit-messages'). Available: ai-governance (auto), agent-delegation (auto), security, git-workflow, code-quality, testing, token-efficiency, documentation, default-commands, rust, python, typescript, go, java, ruby, php, elixir, csharp, pyo3, napi-rs, magnus, ext-php-rs, rustler, wasm",
      "oneOf": [
        {
          "type": "boolean",
          "description": "true = enable all builtins, false = disable all (including auto-includes)"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(!?(ai-governance|agent-delegation|security|git-workflow|code-quality|testing|token-efficiency|documentation|default-commands|rust|python|typescript|go|java|ruby|php|elixir|csharp|r|pyo3|napi-rs|magnus|ext-php-rs|rustler|wasm|jni-rs|extendr|cgo)|![a-z0-9-]+/[a-z0-9-]+)$"
          }
        }
      ]
    },
    "compact": {
      "type": "boolean",
      "description": "When true, omit per-rule '**Priority:**' annotations from generated inline rule sections to reduce output size. Defaults to false."
    },
    "installed_skills": {
      "type": "array",
      "description": "Named skills to install from external repositories. Skills are fetched dynamically during generation.",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Skill name (unique identifier)",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Git repository URL (https://...) or local file path",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Path within repository to skill directory (defaults to skills/<name>)"
          },
          "ref": {
            "type": "string",
            "description": "Git ref - branch, tag, or commit hash (git repos only)"
          },
          "local_override": {
            "type": "string",
            "description": "Local path override for development (used instead of source when present)"
          }
        },
        "additionalProperties": false
      }
    },
    "includes": {
      "type": "array",
      "description": "Content sources (git repositories or local paths) to include and merge",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Local identifier for this include"
          },
          "source": {
            "type": "string",
            "description": "Git repository URL (https://...) or local file path (absolute or relative)"
          },
          "path": {
            "type": "string",
            "description": "Path within git repository to .ai-rulez/ or domain folder (git repos only)"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["rules", "context", "skills", "agents", "mcp"]
            },
            "description": "What content types to import (defaults to all)"
          },
          "ref": {
            "type": "string",
            "description": "Git ref - branch, tag, or commit hash (git repos only)"
          },
          "install_to": {
            "type": "string",
            "description": "Where to merge content (defaults to root)"
          },
          "merge_strategy": {
            "type": "string",
            "enum": ["local-override", "domain-override", "error"],
            "description": "How to handle conflicting files"
          }
        },
        "additionalProperties": false
      }
    },
    "header": {
      "type": "object",
      "description": "Header style configuration for generated files",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["detailed", "compact", "minimal"],
          "description": "Header style: detailed (comprehensive), compact (concise), or minimal (bare minimum)",
          "default": "minimal"
        },
        "timestamp": {
          "type": "boolean",
          "description": "Emit the \"Generated:\" line in generated headers. Set to false in projects that commit generated outputs so the header carries no per-run value.",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "description": "Top-level defaults that propagate into generated outputs when individual content files do not override them",
      "properties": {
        "effort": {
          "type": "string",
          "enum": ["low", "medium", "high", "xhigh", "max", "inherit"],
          "description": "Default reasoning effort applied across providers that support it. Each preset maps the value to its own vocabulary."
        },
        "effort_by_preset": {
          "type": "object",
          "description": "Per-preset reasoning effort overrides. Beats `effort` for the matching preset; per-agent metadata still wins where the preset supports it.",
          "propertyNames": {
            "enum": [
              "claude",
              "cursor",
              "gemini",
              "copilot",
              "continue-dev",
              "windsurf",
              "cline",
              "codex",
              "amp",
              "junie",
              "opencode",
              "hermes",
              "antigravity",
              "mcp"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh", "max", "inherit"]
          }
        },
        "model_by_preset": {
          "type": "object",
          "description": "Per-preset model overrides for agents. Beats the legacy agent-level `model` field for the matching preset; per-agent `<preset>_model` frontmatter still wins. Presets that do not emit a per-agent model frontmatter ignore entries here.",
          "propertyNames": {
            "enum": [
              "claude",
              "cursor",
              "gemini",
              "copilot",
              "continue-dev",
              "windsurf",
              "cline",
              "codex",
              "amp",
              "junie",
              "opencode",
              "hermes",
              "antigravity",
              "mcp"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "compression": {
      "type": "object",
      "description": "DEPRECATED: Compression is now a no-op and will be removed in a future version. Condense content at the source level instead.",
      "deprecated": true,
      "properties": {
        "level": {
          "type": "string"
        },
        "preserve_markdown": {
          "type": "boolean"
        },
        "preserve_code": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "description": "Authoring metadata for a distributable plugin bundle (producer side). Skills, commands, and agents come from the content tree; this block only carries packaging metadata.",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "display_name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string", "description": "Semantic version, e.g. 1.0.0" },
        "author": { "$ref": "#/$defs/authorEntity" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "category": { "type": "string" },
        "brand_color": { "type": "string" },
        "icon": { "type": "string" },
        "logo": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "content_root": {
          "type": "string",
          "description": "Project-relative directory containing plugin-only skills/, commands/, and agents/"
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["claude", "cursor", "codex", "gemini", "kimi", "opencode", "factory", "hermes"]
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "transport": { "type": "string", "enum": ["stdio", "http", "sse"] },
              "url": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event"],
            "properties": {
              "event": { "type": "string" },
              "matcher": { "type": "string" },
              "hooks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["command"],
                  "properties": {
                    "type": { "type": "string" },
                    "command": { "type": "string" },
                    "async": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "statusline": {
          "type": "object",
          "description": "Claude-only status-line script passthrough.",
          "required": ["script"],
          "properties": {
            "script": { "type": "string" },
            "command": { "type": "string" }
          },
          "additionalProperties": false
        },
        "interface": {
          "type": "object",
          "description": "Rich UI block shared by Codex and Kimi manifests.",
          "properties": {
            "display_name": { "type": "string" },
            "short_description": { "type": "string" },
            "long_description": { "type": "string" },
            "developer_name": { "type": "string" },
            "category": { "type": "string" },
            "capabilities": { "type": "array", "items": { "type": "string" } },
            "default_prompt": { "type": "array", "items": { "type": "string" } },
            "website_url": { "type": "string" },
            "privacy_policy_url": { "type": "string" },
            "terms_of_service_url": { "type": "string" },
            "brand_color": { "type": "string" },
            "composer_icon": { "type": "string" },
            "logo": { "type": "string" },
            "logo_dark": { "type": "string" },
            "screenshots": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "gemini": {
          "type": "object",
          "properties": {
            "context_file_name": { "type": "string" }
          },
          "additionalProperties": false
        },
        "kimi": {
          "type": "object",
          "properties": {
            "skill_instructions": { "type": "string" },
            "session_start_skill": { "type": "string" }
          },
          "additionalProperties": false
        },
        "hermes": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Project-relative Python module implementing register(ctx)"
            },
            "requires_python": {
              "type": "string",
              "description": "Python requirement for the generated Hermes wheel (default: >=3.11)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "marketplace": {
      "type": "object",
      "description": "Authoring metadata for the marketplace index emitted for the plugin(s).",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner": { "$ref": "#/$defs/authorEntity" },
        "members": {
          "type": "array",
          "description": "Sub-project directories for a multi-plugin monorepo. Empty means single-plugin.",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "authorEntity": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "$schema": "https://github.com/Goldziher/ai-rulez/schema/ai-rules-v3.schema.json",
      "version": "3.0",
      "name": "my-project",
      "description": "Example V3 configuration",
      "presets": [
        "claude",
        "cursor",
        {
          "name": "custom-guide",
          "type": "markdown",
          "path": "docs/AI_GUIDE.md"
        }
      ],
      "builtins": ["rust", "python", "pyo3", "security", "git-workflow", "code-quality", "testing"],
      "default": "full",
      "profiles": {
        "full": ["backend", "frontend", "qa"],
        "backend": ["backend", "qa"],
        "frontend": ["frontend", "qa"]
      },
      "gitignore": true,
      "header": {
        "style": "detailed"
      }
    }
  ]
}
