{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/review-report.schema.json",
  "title": "ai-rulez review report",
  "description": "Output of `ai-rulez review --format json`: the rubric with its published weights and formula, one entry per selected item, the findings, and with --semantic the judge's verdicts, the run's cost, the calibration status and the gate; with --estimate the egress manifest of a model-judged run. Offline runs have run.phase 0 and run.calls 0.",
  "type": "object",
  "required": ["schema", "rubric", "run", "summary", "items", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "review-report/1" },
    "rubric": {
      "type": "object",
      "required": ["id", "version", "ref", "digest", "formula", "applies_to", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "ref": { "type": "string", "description": "builtin:<id> or the directory name under .ai-rulez/rubrics." },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "formula": { "type": "string" },
        "applies_to": { "type": "array", "items": { "enum": ["skill", "agent", "command", "rule"] } },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "group", "weight", "severity"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "code": { "type": "string", "pattern": "^AR9G[1-7]$" },
              "group": { "enum": ["intrinsic", "contextual"] },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "severity": { "enum": ["info", "warning"] },
              "twins": { "type": "array", "items": { "type": "string" } },
              "needs_body": { "type": "boolean", "description": "Judged only with --content full." }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": ["phase", "offline", "calls", "tokens", "cost_usd"],
      "additionalProperties": false,
      "properties": {
        "phase": { "enum": [0, 1], "description": "0: offline score; 1: a judge ran." },
        "offline": { "type": "boolean" },
        "calls": { "type": "integer", "minimum": 0, "description": "Provider calls made (cache hits are not calls)." },
        "cached": { "type": "integer", "minimum": 0, "description": "Answers served from the response cache." },
        "tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "cap_usd": {
          "type": "number",
          "minimum": 0,
          "description": "The spend ceiling the run was held to; 0 is unlimited."
        },
        "cap_calls": { "type": "integer", "minimum": 0 },
        "incomplete": {
          "type": "boolean",
          "description": "The spend cap or an error ended the run before every item was judged."
        },
        "stopped_because": { "type": "string" },
        "unjudged": { "type": "array", "items": { "type": "string" } },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requested": { "type": "string" },
            "resolved": {
              "type": "array",
              "items": { "type": "string" },
              "description": "The model ids the provider reported."
            }
          }
        },
        "votes": { "type": "integer", "minimum": 1 },
        "content": { "enum": ["descriptions", "full"] },
        "hallucinated_evidence": {
          "type": "integer",
          "minimum": 0,
          "description": "Quotes the judge cited that are not in the item."
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["items", "scored", "withheld", "excluded", "skipped", "mean_score"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "scored": { "type": "integer", "minimum": 0 },
        "withheld": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "mean_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "judged": { "type": "integer", "minimum": 0 },
        "mean_semantic_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "baselined": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "path", "owned", "status", "score"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["skill", "agent", "command", "rule"] },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" },
          "owned": { "type": "boolean" },
          "status": { "enum": ["scored", "withheld", "excluded", "skipped"] },
          "reason": { "type": "string" },
          "redacted": {
            "type": "boolean",
            "description": "[review] on_secret = redact masked a credential before anything was sent."
          },
          "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "weight", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "weight": { "type": "number" },
                "status": { "enum": ["scored", "not-scored"] },
                "verdict": { "enum": ["pass", "warn", "fail"] },
                "preempted": { "type": "boolean" },
                "note": { "type": "string" },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["code", "severity", "message"],
                    "additionalProperties": false,
                    "properties": {
                      "code": { "type": "string" },
                      "name": { "type": "string" },
                      "severity": { "type": "string" },
                      "line": { "type": "integer" },
                      "message": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "semantic": {
            "type": "object",
            "description": "The judge's result for the item (--semantic).",
            "required": ["score", "dimensions", "calls", "cached"],
            "additionalProperties": false,
            "properties": {
              "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
              "calls": { "type": "integer", "minimum": 0 },
              "cached": { "type": "integer", "minimum": 0 },
              "truncated": {
                "type": "boolean",
                "description": "The body was cut to head and tail; the verdicts are reported at info."
              },
              "incomplete": { "type": "boolean", "description": "The spend cap cut the votes of this item short." },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "group", "weight", "status"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "code": { "type": "string" },
                    "group": { "enum": ["intrinsic", "contextual"] },
                    "weight": { "type": "number" },
                    "status": { "enum": ["judged", "unstable", "preempted", "skipped", "error"] },
                    "verdict": { "enum": ["pass", "warn", "fail"] },
                    "agreement": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "The share of votes equal to the verdict."
                    },
                    "votes": { "type": "array", "items": { "enum": ["pass", "warn", "fail"] } },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["quote"],
                        "additionalProperties": false,
                        "properties": { "quote": { "type": "string" }, "where": { "type": "string" } }
                      }
                    },
                    "rationale": { "type": "string" },
                    "suggestion": { "type": "string" },
                    "dropped_votes": { "type": "integer", "minimum": 0 },
                    "preempted_by": { "type": "array", "items": { "type": "string" } },
                    "note": { "type": "string" },
                    "capped": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "severity", "path", "line", "message", "origin", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^AR9G[0-9]$" },
          "name": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "item": { "type": "string" },
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "message": { "type": "string" },
          "origin": { "enum": ["lint-twin", "llm-judge", "run"] },
          "dimension": { "type": "string" },
          "verdict": { "enum": ["pass", "warn", "fail"] },
          "status": { "type": "string" },
          "agreement": { "type": "number" },
          "quote": { "type": "string" },
          "suggestion": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "severity", "message"],
              "additionalProperties": false,
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "severity": { "type": "string" },
                "line": { "type": "integer" },
                "message": { "type": "string" }
              }
            }
          },
          "fingerprint": { "type": "string" },
          "baselined": { "type": "boolean" }
        }
      }
    },
    "egress": {
      "type": "object",
      "description": "What a judged run sent: sizes and a count, never content.",
      "required": ["items", "bytes", "content_mode"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "content_mode": { "enum": ["descriptions", "full"] },
        "host": { "type": "string" },
        "withheld": { "type": "array", "items": { "type": "string" } },
        "redacted": { "type": "array", "items": { "type": "string" } }
      }
    },
    "calibration": {
      "type": "object",
      "description": "Whether a calibration record matches the judge that ran (AR9G9 when not).",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["matched", "missing", "stale", "failed"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "record_digest": { "type": "string" },
        "date": { "type": "string" },
        "age_days": { "type": "integer" },
        "model": { "type": "string" },
        "calibrated_dimensions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The dimensions whose calibration passed: the only ones that may gate."
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["requested", "level", "passed"],
      "additionalProperties": false,
      "properties": {
        "requested": { "type": "boolean" },
        "level": { "enum": ["info", "warning", "error"] },
        "passed": { "type": "boolean" },
        "refused": { "type": "string", "description": "Why the gate could not be evaluated (exit 1)." },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "dimension", "code", "agreement"],
            "additionalProperties": false,
            "properties": {
              "item": { "type": "string" },
              "dimension": { "type": "string" },
              "code": { "type": "string" },
              "agreement": { "type": "number" }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "--models: how the compared models agree, and the items they judge differently.",
      "required": ["models", "pairwise"],
      "additionalProperties": false,
      "properties": {
        "models": { "type": "array", "items": { "type": "string" } },
        "pairwise": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["a", "b", "dimension", "n", "agreement", "kappa"],
            "additionalProperties": false,
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "dimension": { "type": "string" },
              "n": { "type": "integer" },
              "agreement": { "type": "number" },
              "kappa": { "type": "number" }
            }
          }
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "dimension", "verdicts"],
            "additionalProperties": false,
            "properties": {
              "item": { "type": "string" },
              "dimension": { "type": "string" },
              "verdicts": { "type": "object", "additionalProperties": { "enum": ["pass", "warn", "fail"] } }
            }
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["baselined", "new"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "baselined": { "type": "integer", "minimum": 0 },
        "new": { "type": "integer", "minimum": 0 }
      }
    },
    "estimate": {
      "type": "object",
      "description": "The egress manifest and cost range of a model-judged run (--estimate). Nothing is sent: sent is always false. Items carry sizes and hashes, never content.",
      "required": ["sent", "content_mode", "host", "network_allowed", "items", "totals", "cost_known", "cap"],
      "additionalProperties": false,
      "properties": {
        "sent": { "const": false },
        "content_mode": { "enum": ["descriptions", "full"] },
        "model": { "type": "string" },
        "host": { "type": "string" },
        "network_allowed": { "type": "boolean" },
        "ignored_llm_keys": { "type": "array", "items": { "type": "string" } },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path", "bytes", "sha256", "calls"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "bytes": { "type": "integer" },
              "sha256": { "type": "string" },
              "truncated": { "type": "boolean" },
              "calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["group", "dimensions", "bytes", "input_tokens", "output_tokens_max"],
                  "additionalProperties": false,
                  "properties": {
                    "group": { "enum": ["intrinsic", "contextual"] },
                    "dimensions": { "type": "array", "items": { "type": "string" } },
                    "siblings": { "type": "array", "items": { "type": "string" } },
                    "bytes": { "type": "integer" },
                    "input_tokens": { "type": "integer" },
                    "output_tokens_max": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "withheld": { "type": "array", "items": { "type": "string" } },
        "totals": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "cost_min_usd": { "type": "number" },
        "cost_max_usd": { "type": "number" },
        "cost_known": { "type": "boolean" },
        "cap": {
          "type": "object",
          "required": ["max_cost_usd", "max_calls"],
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": { "type": "number", "description": "0 means unlimited." },
            "max_calls": { "type": "integer", "description": "0 means unlimited." }
          }
        },
        "refused": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Why a real run would be refused before its first call."
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "group", "system", "user"],
            "additionalProperties": false,
            "properties": {
              "item": { "type": "string" },
              "group": { "type": "string" },
              "system": { "type": "string" },
              "user": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
