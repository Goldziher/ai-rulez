{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/search-eval.v1.schema.json",
  "title": "ai-rulez search --eval result",
  "description": "Output of `ai-rulez search --eval <cases.yaml> --format json` (or `--from-evals`), also the file `--out` writes and a later run takes as `--baseline`.",
  "type": "object",
  "required": ["schema_version", "k", "n", "n_negative", "modes", "ci95", "cases", "misses"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "k": {
      "type": "integer",
      "minimum": 1
    },
    "n": {
      "type": "integer",
      "minimum": 0,
      "description": "Positive cases (cases with expected skills)."
    },
    "n_negative": {
      "type": "integer",
      "minimum": 0
    },
    "modes": {
      "type": "object",
      "description": "Metrics per ranking mode evaluated (lexical, vector, hybrid).",
      "additionalProperties": {
        "$ref": "#/definitions/metrics"
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/metrics"
      }
    },
    "ci95": {
      "type": "object",
      "description": "95% bootstrap intervals (1000 resamples, fixed seed); informational, never gated on.",
      "additionalProperties": {
        "type": "object",
        "required": ["low", "high"],
        "additionalProperties": false,
        "properties": {
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/case"
      }
    },
    "misses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/case"
      }
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "top_score"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "top": {
            "type": "string"
          },
          "top_score": {
            "type": "number"
          },
          "top_sim": {
            "type": "number",
            "description": "Best cosine of the query to any skill."
          },
          "abstained": {
            "type": "boolean",
            "description": "[search] vector_min_sim left no skill to answer with."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills that must not rank first for this query."
          },
          "avoid_violated": {
            "type": "boolean",
            "description": "An avoided skill ranked first."
          },
          "degraded": {
            "type": "string",
            "description": "Why a vector mode answered this case lexically."
          }
        }
      }
    },
    "flips_vs_baseline": {
      "type": "object",
      "required": ["regressed", "fixed"],
      "additionalProperties": false,
      "properties": {
        "regressed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration": {
      "type": "object",
      "description": "The [search] vector_min_sim that best separates the positive cases from the negative ones (advice from a small sample). Present when both kinds of case were evaluated in a vector or hybrid mode and some threshold beats abstaining on nothing.",
      "required": ["mode", "min_sim", "positives", "positives_kept", "negatives", "negatives_abstained"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["vector", "hybrid"]
        },
        "min_sim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positives": {
          "type": "integer",
          "minimum": 0
        },
        "positives_kept": {
          "type": "integer",
          "minimum": 0
        },
        "negatives": {
          "type": "integer",
          "minimum": 0
        },
        "negatives_abstained": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": ["lexical", "hybrid", "vector"],
      "description": "The primary mode: the first one asked for. The top-level tags, ci95, cases, misses and negatives are this mode's, and the gates check it. Absent in results of releases that only had lexical."
    },
    "by_mode": {
      "type": "object",
      "description": "Full detail of every mode evaluated.",
      "additionalProperties": {
        "$ref": "#/definitions/modeResult"
      }
    },
    "paired_vs_lexical": {
      "type": "object",
      "description": "Per mode and metric, the mean difference to lexical over the same cases with a 95% bootstrap interval; an interval excluding 0 is a real change.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/diff"
        }
      }
    },
    "index": {
      "type": "object",
      "required": ["model", "dims", "dtype", "rows", "stale_items", "missing_items"],
      "additionalProperties": false,
      "description": "The embedding index a hybrid or vector evaluation used.",
      "properties": {
        "model": {
          "type": "string"
        },
        "dims": {
          "type": "integer"
        },
        "dtype": {
          "type": "string"
        },
        "rows": {
          "type": "integer"
        },
        "stale_items": {
          "type": "integer"
        },
        "missing_items": {
          "type": "integer"
        }
      }
    }
  },
  "definitions": {
    "metrics": {
      "type": "object",
      "required": ["n", "top1", "recall_at_k", "hit_at_k", "mrr"],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "top1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall_at_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hit_at_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mrr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ndcg_at_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Present when a case is graded; gains are the grades."
        },
        "avoid_top1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of cases with an avoid list where an avoided skill ranked first; lower is better."
        },
        "abstain_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of negative cases a vector or hybrid ranking answered with nothing (see vector_min_sim); higher is better."
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "expected", "got", "rank", "hit"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "got": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rank": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "hit": {
          "type": "boolean"
        },
        "top_sim": {
          "type": "number",
          "description": "Best cosine of the query to any skill (vector and hybrid rankings)."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string",
          "description": "The role the ranking was scoped to."
        },
        "avoid_violated": {
          "type": "boolean"
        },
        "degraded": {
          "type": "string",
          "description": "Why a vector mode answered this case lexically."
        }
      }
    },
    "diff": {
      "type": "object",
      "required": ["diff", "low", "high"],
      "additionalProperties": false,
      "properties": {
        "diff": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        }
      }
    },
    "modeResult": {
      "type": "object",
      "required": ["metrics", "ci95", "cases", "misses"],
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/definitions/metrics"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/metrics"
          }
        },
        "ci95": {
          "type": "object",
          "description": "95% bootstrap intervals (1000 resamples, fixed seed); informational, never gated on.",
          "additionalProperties": {
            "type": "object",
            "required": ["low", "high"],
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/case"
          }
        },
        "misses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/case"
          }
        },
        "negatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "top_score"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "top": {
                "type": "string"
              },
              "top_score": {
                "type": "number"
              },
              "top_sim": {
                "type": "number",
                "description": "Best cosine of the query to any skill."
              },
              "abstained": {
                "type": "boolean",
                "description": "[search] vector_min_sim left no skill to answer with."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Skills that must not rank first for this query."
              },
              "avoid_violated": {
                "type": "boolean",
                "description": "An avoided skill ranked first."
              },
              "degraded": {
                "type": "string",
                "description": "Why a vector mode answered this case lexically."
              }
            }
          }
        },
        "degraded_cases": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
