{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Goldziher/ai-rulez/main/schema/verify-plugin.schema.json",
  "title": "ai-rulez verify --plugin",
  "description": "Output of `ai-rulez verify --plugin --format json`: whether the generated plugin bundles match their provenance hashes. status is drift (exit 2) when a bundle differs; the error is also on stderr.",
  "type": "object",
  "required": ["schema_version", "status", "configs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["ok", "skipped", "drift"]
    },
    "configs": {
      "type": "integer",
      "minimum": 0
    },
    "error": {
      "type": "string"
    },
    "drift": {
      "description": "Each path where the bundle differs from its sources, with the kind of difference. Present on drift when the failure names paths.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Project-relative path, forward slashes.",
            "type": "string"
          },
          "kind": {
            "enum": ["changed", "missing", "stale-source", "obsolete", "extra", "symlink", "mode"]
          }
        }
      }
    }
  }
}
