[[permission.rules]]
decision = "allow"
pattern = "Bash(npm run test)"

[[permission.rules]]
decision = "allow"
pattern = "Bash(npm run test *)"

[[permission.rules]]
decision = "allow"
pattern = "Bash(git status)"

[[permission.rules]]
decision = "ask"
pattern = "Bash(git push)"

[[permission.rules]]
decision = "ask"
pattern = "Bash(git push *)"

[[permission.rules]]
decision = "deny"
pattern = "Bash(rm -rf)"

[[permission.rules]]
decision = "deny"
pattern = "Bash(rm -rf *)"

[[permission.rules]]
decision = "deny"
pattern = "Bash(curl * | sh)"
