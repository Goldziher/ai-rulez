{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Read(./src/**)",
      "Edit(src/**)",
      "WebFetch(domain:example.com)",
      "mcp__github__create_issue"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "WebFetch(domain:evil.com)",
      "mcp__evil__tool",
      "Bash(curl * | sh)"
    ]
  }
}
