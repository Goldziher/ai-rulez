{
  "PreToolUse": [
    {
      "matcher": "^Execute$",
      "hooks": [
        {
          "type": "command",
          "command": "echo guard",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "audit --strict 'a b'"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$FACTORY_PROJECT_DIR\"/'scripts/boot.sh'"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "echo done",
          "timeout": 5
        }
      ]
    }
  ]
}
