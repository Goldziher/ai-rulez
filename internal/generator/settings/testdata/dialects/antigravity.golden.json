{
  "ai-rulez": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "echo guard",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "audit --strict 'a b'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo done",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
